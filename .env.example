# Azure AI Foundry — Claude deployment.
# Set these locally in .env.local and in your Vercel project settings.
# If they are absent, SignWise runs in demo mode (the sample analysis).

# One of these two — the resource name is enough, base URL wins if both are set:
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-foundry-resource-name.services.ai.azure.com/anthropic

ANTHROPIC_FOUNDRY_API_KEY=your-foundry-project-api-key

# Your Claude deployment name in Foundry (can differ from the model id).
MODEL_ID=claude-opus-5

# Azure OpenAI — the GPT deployment SignWise uses to read contracts.
# Set these locally in .env.local and as App Settings on your Azure Web App.
# If they are absent, SignWise runs in demo mode (the sample analysis).

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # your deployment name (any GPT-4-class model)
AZURE_OPENAI_API_VERSION=2024-10-21

# ElevenLabs — Audio briefing. Pick two voice IDs from your ElevenLabs Voice Lab.
# These credentials stay on the server and are never exposed to the browser.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_HOST_VOICE_ID=your-first-voice-id
ELEVENLABS_GUIDE_VOICE_ID=your-second-voice-id
